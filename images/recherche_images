
import os
import re
import json
import time
import requests
from pathlib import Path
from urllib.parse import urlparse

# Configuration
DOSSIER_IMAGES = Path("images/telechargements")
DOSSIER_DATA = Path("data")
FICHIER_SCRIPTS = DOSSIER_DATA / "scripts_generes.json"
FICHIER_RAPPORT = DOSSIER_DATA / "images_rapport.json"

API = "https://commons.wikimedia.org/w/api.php"

ENTETES = {
    "User-Agent": "ObservateurActifAI/1.0 (documentary research project)"
}

# Licences acceptées
LICENCES_AUTORISEES = (
    "CC BY",
    "CC BY-SA",
    "CC0",
    "Public domain",
    "Public Domain",
    "PD"
)

def identifiant_propre(valeur):
    valeur = re.sub(r"[^a-zA-Z0-9_-]", "", str(valeur))
    return valeur[:80] or "histoire"

def licence_autorisee(nom):
    return any(nom.startswith(x) for x in LICENCES_AUTORISEES)

def rechercher_images(requete, limite=5):
    parametres = {
        "action": "query",
        "generator": "search",
        "gsrsearch": requete,
        "gsrnamespace": 6,
        "gsrlimit": limite,
        "prop": "imageinfo",
        "iiprop": "url|extmetadata",
        "iiurlwidth": 1600,
        "format": "json"
    }

    reponse = requests.get(
        API,
        params=parametres,
        headers=ENTETES,
        timeout=30
    )
    reponse.raise_for_status()

    pages = reponse.json().get("query", {}).get("pages", {})
    resultats = []

    for page in pages.values():
        infos = page.get("imageinfo", [])
        if not infos:
            continue

        info = infos[0]
        metadata = info.get("extmetadata", {})

        licence = metadata.get("LicenseShortName", {}).get("value", "")
        if not licence_autorisee(licence):
            continue

        url = info.get("thumburl") or info.get("url")
        if not url:
            continue

        mime = info.get("mime", "")
        if mime not in ("image/jpeg", "image/png", "image/webp"):
            continue

        resultats.append({
            "titre": page.get("title", ""),
            "url": url,
            "page_source": info.get("descriptionurl", ""),
            "licence": licence,
            "auteur": metadata.get("Artist", {}).get("value", ""),
            "credit": metadata.get("Credit", {}).get("value", ""),
            "usage": metadata.get("AttributionRequired", {}).get("value", ""),
            "mime": mime
        })

    return resultats

def telecharger_image(image, destination):
    reponse = requests.get(
        image["url"],
        headers=ENTETES,
        timeout=45,
        stream=True
    )
    reponse.raise_for_status()

    types = {
        "image/jpeg": ".jpg",
        "image/png": ".png",
        "image/webp": ".webp"
    }

    extension = types.get(image["mime"])
    if not extension:
        return None

    destination = destination.with_suffix(extension)

    with open(destination, "wb") as fichier:
        for morceau in reponse.iter_content(chunk_size=8192):
            if morceau:
                fichier.write(morceau)

    if destination.stat().st_size < 1000:
        destination.unlink(missing_ok=True)
        return None

    return str(destination)

def executer():
    DOSSIER_IMAGES.mkdir(parents=True, exist_ok=True)
    DOSSIER_DATA.mkdir(parents=True, exist_ok=True)

    if not FICHIER_SCRIPTS.exists():
        print("Fichier scripts_generes.json introuvable.")
        return

    with open(FICHIER_SCRIPTS, encoding="utf-8") as fichier:
        scripts = json.load(fichier).get("scripts", [])

    rapport = []

    for script in scripts:
        histoire_id = identifiant_propre(
            script.get("id_histoire", "histoire")
        )
        titre = script.get("titre", "")
        narration = script.get("narration", "")

        requete = titre or narration[:100]

        if not requete.strip():
            continue

        print("Recherche d'images :", titre)

        try:
            images = rechercher_images(requete, limite=8)
            telechargees = []

            for numero, image in enumerate(images[:5], start=1):
                nom = f"{histoire_id}_{numero}"
                destination = DOSSIER_IMAGES / nom

                try:
                    chemin = telecharger_image(image, destination)

                    if chemin:
                        image["fichier"] = chemin
                        telechargees.append(image)
                except Exception as erreur:
                    print("Téléchargement impossible :", erreur)

            rapport.append({
                "id_histoire": histoire_id,
                "titre": titre,
                "nombre_images": len(telechargees),
                "images": telechargees,
                "statut": (
                    "IMAGES_TROUVEES"
                    if telechargees else "AUCUNE_IMAGE"
                )
            })

        except Exception as erreur:
            print("Erreur de recherche :", erreur)
            rapport.append({
                "id_histoire": histoire_id,
                "titre": titre,
                "nombre_images": 0,
                "images": [],
                "statut": "ERREUR",
                "erreur": str(erreur)
            })

        time.sleep(1)

    with open(FICHIER_RAPPORT, "w", encoding="utf-8") as fichier:
        json.dump(
            {"nombre_histoires": len(rapport), "histoires": rapport},
            fichier,
            ensure_ascii=False,
            indent=2
        )

    print("Recherche terminée.")
    print("Rapport :", FICHIER_RAPPORT)

if __name__ == "__main__":
    executer()
